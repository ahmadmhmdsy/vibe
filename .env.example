# ── LLM provider keys (server-side only — never put these in the frontend bundle) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=

# ── Server ──
# Port 8000 is commonly taken (this machine has a foreign httpd on it), and
# `python -m vibe` now honours VIBE_PORT, so pick a free port.
VIBE_HOST=127.0.0.1
VIBE_PORT=7321

# ── Workspaces ──
# Where generated app projects live (one directory per session)
VIBE_WORKSPACE_DIR=~/vibe-workspaces

# ── Limits ──
VIBE_MAX_FIX_ITERATIONS=3
VIBE_SESSION_TOKEN_BUDGET=          # USD cap per session; empty = unlimited
VIBE_DEV_SERVER_IDLE_TIMEOUT_MIN=30
